# TOWEMS backup timer environment.
# Copy to /etc/towems/backup.env, fill in real values, and chmod 600.
# NEVER commit the filled-in file. The web application does not read it.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mrm_system
TOMS_BACKUP_DIR=/srv/toms/_backups/postgres

# Preferred: encrypt to a GPG public key. The private key must be kept off
# this host. Import the public key into the towems user's GPG keyring.
TOMS_BACKUP_GPG_RECIPIENT=backup@example.com

# Alternative: symmetric GPG. The passphrase file must be readable by towems
# and must not be stored beside the backups.
# TOMS_BACKUP_GPG_PASSPHRASE_FILE=/etc/towems/backup.passphrase

# Optional off-host destination. Choose one or both. A directory must be a
# mounted remote or a genuinely separate host, not the local backup disk.
# TOMS_BACKUP_OFFSITE_DIR=/mnt/offsite/towems
# TOMS_BACKUP_UPLOAD_COMMAND="rclone copy {file} remote:towems-backups"

# Newest backup per UTC day for 30 days, plus the newest per month for 12
# months. Off-host retention must be configured on the destination too.
TOMS_BACKUP_RETENTION_DAILY=30
TOMS_BACKUP_RETENTION_MONTHLY=12
TOMS_BACKUP_SNAPSHOT=1

# Backup freshness alerts. The nightly backup has a 36-hour limit: one missed
# night is tolerated, while two consecutive misses alert. The monthly restore
# drill has a 35-day limit.
TOMS_BACKUP_MAX_AGE_HOURS=36
TOMS_RESTORE_MAX_AGE_DAYS=35

# Optional JSON webhook for failed health checks. The payload contains only
# timestamps, backup file names, ages and failure messages, never credentials.
# TOMS_BACKUP_ALERT_WEBHOOK=https://alerts.example.com/towems-backup
# TOMS_BACKUP_ALERT_TIMEOUT=10

# Needed when the application database role cannot CREATE/DROP databases.
# The restore drill creates a temporary toms_restore_* database and drops it.
# TOMS_BACKUP_RESTORE_ADMIN_URL=postgresql://ADMIN:PASSWORD@HOST:5432/postgres
