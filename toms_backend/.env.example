# TOWEMS backend environment template - copy to .env and fill in locally.
# NEVER commit .env. No real credentials belong in this file.

# --- Required ---------------------------------------------------------------
DJANGO_SECRET_KEY=generate-a-long-random-value
DJANGO_SETTINGS_MODULE=toms.settings.dev

# Staging/development database copy. Never point this at production from a
# workstation.
#   Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://toms_user:change-me@localhost:5432/toms_staging

# --- Hosts / origins --------------------------------------------------------
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Behaviour --------------------------------------------------------------
DJANGO_DEBUG=true
TOMS_SESSION_AGE=3600
TOMS_PAGE_SIZE=25
TOMS_LOG_LEVEL=INFO

# Leave false unless you have approved writing upgraded hashes to the legacy
# `users` table.
TOMS_REHASH_ON_LOGIN=false

# --- Local PostgreSQL shortcuts (used only when DATABASE_URL is absent) -----
# PGUSER=postgres
# PGPASSWORD=
# PGHOST=localhost
# PGPORT=5432
# TOMS_DEV_DB_NAME=toms_staging

# --- Mapping ---------------------------------------------------------------
# Basemap id served as the default (see /api/map/config/): streets,
# streets_dark, satellite, hybrid, terrain or internal.
# TOMS_DEFAULT_BASEMAP=streets

# Self-hosted tile service. When set, "Organisation basemap" appears in the
# basemap picker and all map traffic can stay inside the organisation network.
# TOMS_INTERNAL_TILE_URL=https://tiles.internal/{z}/{x}/{y}.png
# TOMS_INTERNAL_TILE_ATTRIBUTION=Organisation map service
# TOMS_INTERNAL_TILE_MAX_ZOOM=19

# --- Place search (map picker) ---------------------------------------------
# Searches buildings, facilities and businesses ("SM City Butuan") for the
# mission / operational-area map picker. Leave the key empty to use
# OpenStreetMap Nominatim, which needs no account. Set TOMS_GEOCODER=off to
# block external lookups entirely (the picker keeps its offline PSGC search).
# TOMS_GEOCODER=auto            # auto | google | nominatim | off
# TOMS_GOOGLE_MAPS_API_KEY=
# TOMS_GEOCODER_TIMEOUT=8
# TOMS_GEOCODER_CACHE_SECONDS=600
