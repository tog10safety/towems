    <!-- First-run explanations: each one says what the permission buys, because
         an unexplained system dialog is what people refuse. -->
    <string name="setup_battery_title">Keep alerts arriving</string>
    <string name="setup_battery_message">Android pauses background apps to save battery, which can silence TOWEMS alerts and stop the driver tracker while the screen is off.\n\nAllow TOWEMS to run without battery restrictions. On Xiaomi, Huawei, Oppo and vivo phones, also switch on Autostart for TOWEMS in Settings.</string>
    <string name="setup_location_title">Keep tracking with the screen off</string>
    <string name="setup_location_message">The driver tracker reports the vehicle position during a run. If TOWEMS may only use location while it is open, tracking stops as soon as the phone locks.\n\nOn the next screen choose Allow all the time.</string>
    <string name="setup_allow">Allow</string>
    <string name="setup_later">Not now</string>
    <string name="setup_app_info">App info</string>

    <!-- The strip above the web app: whether this phone can really be reached.
         A person who hears nothing has no other way to tell a quiet account from
         a silenced watcher. -->
    <string name="watcher_live_title">Watcher is live</string>
    <string name="watcher_live_detail">Checked %1$s. Alerts and messages arrive here.</string>
    <string name="watcher_blocked_title">Notifications are off</string>
    <string name="watcher_blocked_detail">Android is blocking TOWEMS alerts. Tap to allow them.</string>
    <string name="watcher_no_token_title">No alert key yet</string>
    <string name="watcher_no_token_detail">Sign in to TOWEMS; the watcher trades that sign-in for its own key.</string>
    <string name="watcher_signing_in_title">Watcher is signing in</string>
    <string name="watcher_signing_in_detail">Asking the server for this phone\'s alert key.</string>
    <string name="watcher_stopped_title">Watcher is not running</string>
    <string name="watcher_stopped_detail">Tap to start it. Alerts cannot arrive while it is off.</string>
    <string name="watcher_offline_title">No reply from TOWEMS</string>
    <string name="watcher_offline_detail">Last reply %1$s. Retrying every 20 seconds.</string>
    <string name="watcher_offline_never">The server has never answered this phone yet. Check the connection.</string>
