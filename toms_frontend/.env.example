# Frontend environment template - copy to .env.local for overrides.
# In development the Vite proxy forwards /api to Django, so no base URL is
# needed and no credential ever lives in the frontend bundle.

# Only set this when the API is served from a different origin.
# VITE_API_BASE_URL=https://toms.example.mil/api

# Where the dev server proxies API requests (see vite.config.js).
# VITE_DJANGO_ORIGIN=http://127.0.0.1:8000
